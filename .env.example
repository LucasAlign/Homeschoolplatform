# === Firebase (backend) ===
# Public client config (safe to expose in the browser). Fill from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="lucas-align-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Set to "true" to point the client SDK at the local Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"

# Server-only. In production provide a service-account JSON (or use application
# default credentials); leave blank when running against the emulator.
FIREBASE_SERVICE_ACCOUNT=""

# === Local dev against the Emulator Suite ===
# Copy these into .env.local (gitignored) to click through the approval flows.
# Points the server-side Admin SDK at the local Firestore emulator; WITHOUT this
# `npm run dev` would try to reach production. Never set in production.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# GCLOUD_PROJECT="lucas-align-dev"

# Dev-only session principal (see src/lib/auth/session.ts — NOT real auth). These
# default to the demo owner seeded by scripts/seed-emulator.ts; override to sign
# in as a different seeded member.
# DEV_SESSION_UID="owner-uid"
# DEV_SESSION_HOUSEHOLD="demo-household"
