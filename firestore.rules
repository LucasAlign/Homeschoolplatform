rules_version = '2';

// Phase 0 foundation rules. Encodes the non-waivable invariants from
// docs/mvp-specification.md §17: household isolation, role-scoped access,
// answer-key isolation, consent gating, and immutable server-written audit.
//
// Rules are the CLIENT gate and are deny-by-default. Server code uses the
// Admin SDK (which bypasses these rules) and MUST repeat authorization via
// src/modules/identity/authorize.ts (invariant 3: fail-closed authz at every
// sensitive access, on both sides of the boundary).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function memberDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function isMember(hid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function role(hid) { return memberDoc(hid).data.role; }
    function hasAnyRole(hid, roles) { return isMember(hid) && (role(hid) in roles); }
    function isOwner(hid) { return hasAnyRole(hid, ['household_owner']); }
    function isParentPlus(hid) { return hasAnyRole(hid, ['household_owner', 'parent_admin']); }
    function isAdult(hid) {
      return hasAnyRole(hid, ['household_owner', 'parent_admin', 'instructor_reviewer']);
    }
    // Instructor Reviewers are limited to their assigned Students (issue #12).
    function reviewerCanSeeStudent(hid, sid) {
      return role(hid) != 'instructor_reviewer'
        || (sid in memberDoc(hid).data.scopeStudentIds);
    }
    // Consent gate for later child-data phases (issue #15): collection requires Active consent.
    function consentActive(hid, sid) {
      return get(/databases/$(database)/documents/households/$(hid)/students/$(sid)).data.consentState == 'Active';
    }

    // Invariant 1 (household isolation) + fail-closed default: deny everything
    // not explicitly permitted below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /households/{hid} {
      allow get: if isMember(hid);
      allow create, update, delete: if isOwner(hid);

      // Memberships & roles are Household-Owner-managed (issue #12).
      match /members/{uid} {
        allow read: if isMember(hid);
        allow write: if isOwner(hid);
      }

      // Students: adults read (Instructor Reviewer only within scope); parent+ write.
      // consentState is server-managed by module K and is client-immutable.
      match /students/{sid} {
        allow read: if isAdult(hid) && reviewerCanSeeStudent(hid, sid);
        allow create: if isParentPlus(hid)
          && !('consentState' in request.resource.data.keys());
        allow update: if isParentPlus(hid)
          && request.resource.data.consentState == resource.data.consentState;
        allow delete: if isParentPlus(hid);
      }

      // Curriculum imports: server-written (module B via Admin SDK). Adults may
      // read progress within scope; clients never write directly.
      match /imports/{importId} {
        allow read: if isAdult(hid);
        allow write: if false;

        // Extracted drafts are advisory and adult-only until Approved. Never
        // student-readable (they may contain unresolved/answer-adjacent content).
        match /draft/{d} {
          allow read: if isParentPlus(hid);
          allow write: if false;
        }
      }

      // Courses: materialized on parent approval (server-written). Adults read
      // within scope; Student read arrives with course adoption in Phase 2.
      match /courses/{courseId} {
        allow read: if isAdult(hid);
        allow write: if false;
      }

      // Planning (module C), all server-written via Admin SDK.
      // Proposed Schedules are advisory drafts; Plan Revisions are immutable;
      // the Approved Plan is a pointer to the current revision. Student-scoped
      // read arrives with the student-profile linkage in a later phase.
      match /proposals/{pid} {
        allow read: if isAdult(hid);
        allow write: if false;
      }
      match /planRevisions/{rid} {
        allow read: if isAdult(hid);
        allow write: if false; // immutable, append-only, server-written
      }
      match /plans/{scopeKey} {
        allow read: if isAdult(hid);
        allow write: if false;
      }

      // Daily work (module D), all server-written via Admin SDK. Submissions,
      // Evidence, and Support Events are child-data records: the server gates
      // every write on Active consent (assertCollectionAllowed) before it runs,
      // so clients never write here directly. Adults read within scope;
      // Student-scoped reads arrive with the student-uid ↔ Student-profile
      // linkage in a later phase (as with planning). Answer-key material never
      // appears in any of these records (invariant 2).
      match /submissions/{subId} {
        allow read: if isAdult(hid);
        allow write: if false;
      }
      match /evidence/{evId} {
        allow read: if isAdult(hid);
        allow write: if false;
      }
      // Support Events carry assistance context; adults read, clients never write.
      match /supportEvents/{seId} {
        allow read: if isAdult(hid);
        allow write: if false;
      }

      // Assessment & grading (module E), all server-written via Admin SDK.
      //
      // AI Assessments are ADVISORY and carry a disclosure envelope; they are
      // adult-only (never student-readable — a Student sees suggested-vs-final on
      // the Official Grade, not the raw advisory assessment). Official Grades are
      // the immutable, parent-approved record-of-truth: no client write, and a
      // grade is never mutated or deleted (invariant 5) — resubmission SUPERSEDES
      // with a new grade. Answer-key material never appears in either record
      // (invariant 2). Student-scoped grade reads arrive with the student-uid ↔
      // Student-profile linkage in a later phase (as with daily work).
      match /aiAssessments/{aid} {
        allow read: if isAdult(hid);
        allow write: if false;
      }
      match /officialGrades/{gid} {
        allow read: if isAdult(hid);
        allow write: if false; // immutable, append-only, server-written
      }

      // Mastery & adaptation (module F), all server-written via Admin SDK.
      // Mastery Records are immutable via supersession (invariant 5); a canonical
      // level is confirmed only by a parent through the server. Remediation/
      // enrichment drafts are advisory and adult-only until a parent approves
      // them toward Planning — they never auto-enter a plan (invariant 4).
      match /masteryRecords/{mid} {
        allow read: if isAdult(hid);
        allow write: if false;
      }
      match /remediationDrafts/{rid} {
        allow read: if isAdult(hid);
        allow write: if false;
      }

      // Review & Notifications (module G), all server-written via Admin SDK.
      //
      // Review Flags are NEUTRAL, evidence-backed requests for adult attention;
      // they never block learning and are never student-readable (a flag is a
      // request FOR adults). Adults read within scope; resolution is a server
      // operation (review.ts) under fail-closed authorize — clients never write.
      // Notifications are the cadence records (Immediate / Daily / Weekly),
      // server-routed and adult-read; clients never write. Answer-key material
      // never appears in either record (invariant 2).
      match /reviewFlags/{flagId} {
        allow read: if isAdult(hid)
          && reviewerCanSeeStudent(hid, resource.data.studentId);
        allow write: if false;
      }
      match /notifications/{noteId} {
        allow read: if isAdult(hid)
          && reviewerCanSeeStudent(hid, resource.data.studentId);
        allow write: if false;
      }

      // Household AI allowance/reserve snapshot: server-managed (module J).
      // Owner may read; clients never write.
      match /allowance/{aid} {
        allow read: if isOwner(hid);
        allow write: if false;
      }

      // Consent receipts: server-written (module K). Owner may read; clients never write.
      match /consents/{cid} {
        allow read: if isOwner(hid);
        allow write: if false;
      }

      // Audit events: append-only, server-written (module L). Owner may read
      // (household-visible staff access, invariant 9). Clients never write.
      match /audit/{eid} {
        allow read: if isOwner(hid);
        allow write: if false;
      }

      // Answer Keys / Teacher Guides: adult-only material, isolated from ALL
      // client access (invariant 2). Reached only via the server through a
      // separate audited path.
      match /answerKeys/{akId} {
        allow read, write: if false;
      }
    }
  }
}
