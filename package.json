{
  "name": "homeschool-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run tests/unit",
    "emulators": "firebase emulators:start",
    "emulators:seed": "firebase emulators:exec --only auth,firestore \"node --experimental-strip-types scripts/seed-emulator.ts\"",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\""
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
